+  static List<Map<dynamic, dynamic>> _maps(dynamic v) => v is List ? v.whereType<Map<dynamic, dynamic>>().toList() : [];
+
+  /// Riassunto da mostrare nella chat, scritto a partire dall'analisi.
+  String _summary(Map<String, dynamic>? a) {
+    if (a == null) return 'Ho salvato il documento ma non sono riuscito a leggerlo. Riprova dai Documenti.';
+    final riassunto = (a['riassunto'] as String?)?.trim() ?? '';
+    if (a['leggibile'] == false) {
+      return riassunto.isNotEmpty ? riassunto : 'Non riesco a leggere il documento. Rifai la foto con più luce.';
+    }
+    final b = StringBuffer();
+    final tipo = a['tipo_documento'] as String?;
+    final ente = a['ente'] as String?;
+    if (tipo != null) b.writeln(ente != null ? '$tipo — $ente' : tipo);
+    if (riassunto.isNotEmpty) {
+      b.writeln();
+      b.writeln(riassunto);
+    }
+    final significa = (a['cosa_significa'] as String?)?.trim();
+    if (significa != null && significa.isNotEmpty) {
+      b.writeln();
+      b.writeln('Cosa significa: $significa');
+    }
+    final fare = _maps(a['cosa_devi_fare']);
+    if (fare.isNotEmpty) {
+      b.writeln();
+      b.writeln('Cosa devi fare:');
+      for (final f in fare) {
+        b.writeln('• ${f['azione']}');
+      }
+    }
+    final scadenze = _maps(a['scadenze']);
+    if (scadenze.isNotEmpty) {
+      b.writeln();
+      b.writeln('Scadenze:');
+      for (final s in scadenze) {
+        final data = s['data'] as String?;
+        final quando = data != null ? itDate(parseDay(data)) : (s['regola'] as String? ?? 'da verificare');
+        b.writeln('• ${s['etichetta']}: $quando');
+      }
+    }
+    final importi = _maps(a['importi']);
+    if (importi.isNotEmpty) {
+      b.writeln();
+      b.writeln('Importi:');
+      for (final i in importi) {
+        b.writeln('• ${i['etichetta']}: ${euro(i['valore'] as num)}');
+      }
+    }
+    final extra = <String>[];
+    final priorita = a['priorita'] as String?;
+    if (priorita != null) extra.add('Priorità: $priorita');
+    final minuti = a['tempo_stimato_minuti'];
+    if (minuti is num) extra.add('Tempo stimato: ${minuti.round()} minuti');
+    if (extra.isNotEmpty) {
+      b.writeln();
+      b.writeln(extra.join(' · '));
+    }
+    final truffa = (a['sospetto_truffa'] as Map?)?['livello'];
+    if (truffa == 'medio' || truffa == 'alto') {
+      b.writeln();
+      b.writeln('Attenzione: questo documento ha elementi sospetti. Prima di pagare, verifica il mittente sui siti ufficiali.');
+    }
+    if (a['da_controllare'] == true) {
+      b.writeln();
+      b.writeln('Alcuni dati potrebbero non essere letti bene: controllali con il documento originale.');
+    }
+    b.writeln();
+    b.write('Scrivimi pure le tue domande su questo documento.');
+    return b.toString().trim();
+  }
